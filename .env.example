# ─────────────────────────────────────────────────────────────
# DispatchOps AI — copy to .env.local and fill in.
# .env.local is gitignored. Never commit real keys.
# ─────────────────────────────────────────────────────────────

# Qwen — Alibaba Cloud Model Studio, OpenAI-compatible mode.
# Also works with OpenRouter (base URL https://openrouter.ai/api/v1,
# model qwen/qwen3.7-plus) or a self-hosted vLLM endpoint.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus

# Guardrail: reroutes costing at or above this halt for human approval.
MAX_AUTONOMOUS_SPEND_USD=500

# Langfuse (observability & evaluation). Leave blank to disable tracing —
# the app runs normally without it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Segments traces in the Langfuse UI: development | staging | production
LANGFUSE_TRACING_ENVIRONMENT=development

# Set to 1 to run the scripted offline agent instead of calling Qwen.
MOCK_AGENT=0
