{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dispatchops-ai",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },

  // Owns the LangGraph checkpointer and the mock TMS. Workers gives no isolate
  // affinity, so without this a resume can land where the interrupt was never
  // seen. See src/server/dispatch-room.ts.
  "durable_objects": {
    "bindings": [
      {
        "name": "DISPATCH_ROOM",
        "class_name": "DispatchRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      // SQLite-backed classes are the free-plan storage backend.
      "new_sqlite_classes": ["DispatchRoom"]
    }
  ],

  // QWEN_API_KEY and QWEN_BASE_URL are set with `wrangler secret put`, not here.
  // A dedicated Model Studio workspace host identifies the workspace, so it does
  // not belong in a committed file.
  // All three spend ceilings are stated here rather than left to their code
  // defaults. What the agent is allowed to spend unsupervised should be legible
  // in the deployment config, not only in the source that reads it.
  "vars": {
    "MAX_AUTONOMOUS_SPEND_USD": "500",
    "MAX_LOAD_SPEND_USD": "2000",
    "MAX_DAILY_SPEND_USD": "5000",
    "MOCK_AGENT": "0",
    "QWEN_MODEL": "qwen3.7-plus"
  }
}
